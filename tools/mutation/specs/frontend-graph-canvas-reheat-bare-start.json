{
  "id": "frontend-graph-canvas-reheat-bare-start",
  "description": "The reheat calls start() without stop() first; on a running layout that is a no-op, so the new pins never reach FA2 (T11-1).",
  "target": {
    "file": "packages/frontend/src/graph/GraphCanvas.tsx",
    "find": "    fa2.stop();\n    fa2.start();",
    "replace": "    fa2.start();"
  },
  "suite": {
    "kind": "vitest",
    "cwd": "packages/frontend",
    "args": ["run", "src/graph/GraphCanvas.test.tsx"]
  },
  "expect": "killed"
}
