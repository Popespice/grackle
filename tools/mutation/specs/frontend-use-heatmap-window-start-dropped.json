  "target": {
    "file": "packages/frontend/src/graph/useHeatmap.ts",
    "find": "      traceWindowSize,\n      traceWindowStart\n    );",
    "replace": "      traceWindowSize\n    );"
  },
  "suite": {
    "kind": "vitest",
    "cwd": "packages/frontend",
    "args": ["run", "src/graph/useHeatmap.test.tsx"]
